# Rendered by calnode-fly.sh from deploy/fly/.env — do not edit the rendered copy by hand.
app = '${FLY_APP}'
primary_region = '${FLY_REGION}'

[build]

[[mounts]]
  source = 'data'
  destination = '/data'

[http_service]
  internal_port = 3000
  force_https = true
  auto_stop_machines = '${AUTO_STOP}'
  auto_start_machines = true
  min_machines_running = ${FLY_MIN_MACHINES}
  processes = ['app']

  [[http_service.checks]]
    interval = '30s'
    timeout = '5s'
    grace_period = '20s'
    method = 'GET'
    path = '/healthz'

[[vm]]
  memory = '${FLY_VM_MEMORY}'
  cpu_kind = 'shared'
  cpus = 1
