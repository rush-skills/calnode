# Copy to deploy/fly/.env (git-ignored) or export these as environment variables.
# Every command of calnode-fly.sh reads this file first; a variable already set in the
# environment wins over the file.

# ── Fly.io ────────────────────────────────────────────────────────────────────────
FLY_API_TOKEN=                      # fly tokens create deploy -a <app>   (or a personal token)
FLY_APP=ijewel3d-bookings           # app name (globally unique on Fly)
FLY_ORG=personal                    # org slug (fly orgs list)
FLY_REGION=ams                      # primary region (fly platform regions)
FLY_VOLUME_SIZE_GB=1                # SQLite volume size
FLY_VM_MEMORY=1gb                   # shared-cpu-1x memory
FLY_MIN_MACHINES=1                  # keep this many running; 0 lets Fly stop it when idle

# ── Calnode ───────────────────────────────────────────────────────────────────────
BASE_URL=https://bookings.example.com     # https://<custom domain>, or https://<app>.fly.dev before the domain exists
PUBLIC_BASE_URL=                          # optional booker-facing host; empty = BASE_URL
CALNODE_ENCRYPTION_KEY=                   # empty on first `init`: generated and written back here. KEEP A COPY.
CALNODE_RECOVERY_SECRET=                  # same. Store it separately from the encryption key.
LOG_LEVEL=info
TRUSTED_PROXY_CIDRS=                      # Fly's proxy is already handled; add only your own CDN ranges
FRAME_ANCESTORS=                          # origins allowed to frame the admin UI (not needed for /live or /embed/* pages)

# Email (optional at boot; can also be set in Settings → Email)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_SMTP_STARTTLS=

# Google OAuth (optional at boot; can also be set in Settings → Google OAuth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Backups (Litestream → any S3-compatible bucket; Cloudflare R2 shown) ──────────
LITESTREAM_REPLICA_URL=                   # s3://<bucket>/calnode   (empty = backups OFF)
LITESTREAM_ENDPOINT=                      # https://<account-id>.r2.cloudflarestorage.com (unset for AWS)
LITESTREAM_REGION=auto                    # auto for R2
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ── Post-deploy workspace settings (applied by `settings apply` through the admin API) ──
CALNODE_API_KEY=                          # an admin's API key from Admin → API Keys (cno_…)
SETTINGS_DEFAULT_PARTICIPANTS=            # comma-separated, e.g. team@example.com
SETTINGS_DEFAULT_CALENDAR_MESSAGE=        # HTML or text, e.g. <p>This call may be recorded for quality and training purposes.</p>
SETTINGS_SHOW_HOST_NAMES=                 # true | false (false = team label on multi-host events)
SETTINGS_SIGNIN_DOMAINS=                  # comma-separated Workspace domains allowed to sign in, e.g. example.com
SETTINGS_BUSINESS_NAME=                   # shown as "<name> team" and in the page header
